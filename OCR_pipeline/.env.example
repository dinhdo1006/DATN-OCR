# Sao chép thành .env rồi điền mật khẩu: copy .env.example .env
# docker compose tự đọc file .env cùng thư mục với docker-compose.yml

# Tài khoản MinIO (cũng là access key / secret key S3 cho các worker và NiFi)
MINIO_ACCESS_KEY=admin
MINIO_SECRET_KEY=doi_mat_khau_nay

# Tài khoản NiFi (mật khẩu tối thiểu 12 ký tự)
NIFI_USERNAME=admin
NIFI_PASSWORD=doi_mat_khau_nay_12kytu
